# Distribution Software ERP — Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

# ─── Server (Express Backend) ───────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL — Supabase) ────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/distribution_erp
DB_HOST=localhost
DB_PORT=5432
DB_NAME=distribution_erp
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# ─── Session ─────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-64-char-hex-string-in-production
SESSION_MAX_AGE_MS=1800000
SESSION_COOKIE_NAME=erp_session

# ─── CORS (comma-separated origins for production) ──────────────
ALLOWED_ORIGINS=https://your-domain.vercel.app

# ─── Frontend (Vite — prefixed with VITE_) ──────────────────────
# Set to "true" ONLY for development/Vercel demo.
# Production MUST be "false" or unset.
VITE_DEMO_MODE=false

# Distribution Software ERP — Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/distribution_erp
DB_HOST=localhost
DB_PORT=5432
DB_NAME=distribution_erp
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# Session
SESSION_SECRET=change-this-to-a-random-64-char-hex-string-in-production
SESSION_MAX_AGE_MS=1800000
SESSION_COOKIE_NAME=erp_session

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
